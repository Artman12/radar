    <!-- Threat Knowledge Base -->
    <string name="kb_title">Довідник повітряних цілей</string>
    <string name="kb_subtitle">Усі іконки радара, характеристики та дії безпеки</string>
    <string name="kb_intro_note">Іконки повертаються за курсом руху цілі. Цілі у вашому радіусі попередження підсвічуються яскравим червоно-жовтим кільцем.</string>
