    <path
        android:fillColor="#66EF4444"
        android:pathData="M71.3,36.1 A4.5,4.5 0 1,0 71.3,45.1 A4.5,4.5 0 1,0 71.3,36.1 Z" />
    <path
        android:fillColor="#FFFF4D4D"
        android:pathData="M71.3,38.0 A2.6,2.6 0 1,0 71.3,43.2 A2.6,2.6 0 1,0 71.3,38.0 Z" />

