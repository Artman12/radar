                    android:offset="0.0" />
                <item
                    android:color="#243B9BFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crisp leading edge of radar sweep -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 L71.21,29.43"
        android:strokeWidth="1.7"
        android:strokeColor="#D993C5FD"
        android:strokeLineCap="round" />

    <!-- Outer radar ring (r = 30, boosted stroke and brightness for small launcher sizes) -->
    <path
