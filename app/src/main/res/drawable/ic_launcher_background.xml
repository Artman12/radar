<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rich steel-navy radial gradient so the icon stands out cleanly on dark & light wallpapers -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="68"
                android:type="radial">
                <item
                    android:color="#FF24344D"
                    android:offset="0.0" />
                <item
                    android:color="#FF182436"
                    android:offset="0.6" />
                <item
                    android:color="#FF0F1724"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Luminous radar-blue radial glow behind the rings and shield -->
    <path android:pathData="M54,18 A36,36 0 1,0 54,90 A36,36 0 1,0 54,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="36"
                android:type="radial">
                <item
                    android:color="#663B9BFF"
                    android:offset="0.0" />
                <item
                    android:color="#2E2C86E8"
                    android:offset="0.55" />
                <item
                    android:color="#002C86E8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
